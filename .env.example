# Public site URL (no trailing slash). On Cloudflare, set this to your Workers/custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudflare R2 (S3-compatible)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=minicowfarm-media
# Public media base URL (custom domain or r2.dev public bucket URL), no trailing slash
R2_PUBLIC_MEDIA_URL=https://media.example.com

# Optional email notifications (not required for inquiries to save)
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM=noreply@minicowfarm.com
# EMAIL_TO=hello@minicowfarm.com
